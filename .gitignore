# Local credentials and environment
secrets.h
**/secrets.h
.env
.env.*
!.env.example
*.pem
*.key

# Compiled firmware can contain WiFi passwords and API keys.
# Exception: prebuilt/ holds firmware compiled from secrets.example.h (placeholders only).
.build/
.build-*/
build/
*.elf
*.map
*.o
*.bin
!prebuilt/*.bin

# Rebuildable assets/caches; the offline ZIP explicitly includes selected assets.
# Exception: pet-assets.bin is tracked so a fresh clone can flash without rebuilding.
generated/*
!generated/pet-assets.bin
!generated/asset-report.json
assets/pc2005/
__pycache__/
*.pyc
.venv/
dist/
*.zip
*.zip.sha256
PACKAGE_MANIFEST.json

# Legacy generated RGB565 frame data (~15 MB, regenerable with legacy/rgb565 scripts).
legacy/rgb565/whale_frames.h
